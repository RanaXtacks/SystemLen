# SystemLens Environment Configuration Template
# Copy this file to .env and fill in your values.
# .env is ignored by git and will never be committed.

# Preferred: Complete PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/postgres

# Alternatively: Individual connection parameters
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your_password_here
